# Copy to .env and fill in real values. .env is git-ignored; this file is not,
# so never put a real secret here.

# Postgres container
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=youth_bank

# API (server/) - used by `npm run dev` on your laptop
DATABASE_URL=postgres://bank:change-me@localhost:5433/youth_bank
# Signs login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
